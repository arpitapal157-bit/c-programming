#include <iostream>
using namespace std;

class B;

class A {
    int x;

public:
    void getData() {
        cout << "Enter first number: ";
        cin >> x;
    }

    friend void swap(A &, B &);
};

class B {
    int y;

public:
    void getData() {
        cout << "Enter second number: ";
        cin >> y;
    }

    friend void swap(A &, B &);
};

void swap(A &a, B &b) {
    int temp;
    temp = a.x;
    a.x = b.y;
    b.y = temp;
}

int main() {
    A obj1;
    B obj2;

    obj1.getData();
    obj2.getData();

    cout << "\nBefore swapping:";
    swap(obj1, obj2);

    cout << "\nAfter swapping:";
    cout << "\nNumbers are swapped successfully.";

    return 0;
}
