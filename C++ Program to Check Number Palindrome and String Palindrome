#include <iostream>
#include <string>
using namespace std;

int main()
{
    int num, rem, rev = 0, temp;
    string str, revStr = "";

    // Number Palindrome
    cout << "Enter a number: ";
    cin >> num;

    temp = num;

    while (num > 0)
    {
        rem = num % 10;
        rev = rev * 10 + rem;
        num = num / 10;
    }

    if (temp == rev)
        cout << "Number is Palindrome" << endl;
    else
        cout << "Number is not Palindrome" << endl;

    // String Palindrome
    cout << "Enter a string: ";
    cin >> str;

    for (int i = str.length() - 1; i >= 0; i--)
    {
        revStr += str[i];
    }

    if (str == revStr)
        cout << "String is Palindrome" << endl;
    else
        cout << "String is not Palindrome" << endl;

    return 0;
}
